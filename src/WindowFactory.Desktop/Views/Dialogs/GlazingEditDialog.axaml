<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WindowFactory.Desktop.Views.Dialogs.GlazingEditDialog"
        Title="{Binding Title}" Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/logo.png">
  <StackPanel Margin="20" Spacing="10">
    <StackPanel><TextBlock Classes="label" Text="Название"/><TextBox Text="{Binding GlazingName}"/></StackPanel>
    <Grid ColumnDefinitions="*,Auto,*">
      <StackPanel Margin="0 0 8 0"><TextBlock Classes="label" Text="Толщина, мм"/>
        <NumericUpDown Value="{Binding ThicknessMm}" Minimum="0" Maximum="100" FormatString="0"/></StackPanel>
      <CheckBox Grid.Column="1" Content="Энергосбережение" IsChecked="{Binding EnergySaving}" VerticalAlignment="Bottom" Margin="0 0 12 4"/>
      <StackPanel Grid.Column="2"><TextBlock Classes="label" Text="Цена, ₽/м²"/>
        <NumericUpDown Value="{Binding PricePerM2}" Minimum="0" Maximum="100000" Increment="10" FormatString="0.00"/></StackPanel>
    </Grid>
    <TextBlock Classes="error" Text="{Binding ErrorText}" IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Отмена" Command="{Binding CancelCommand}"/>
      <Button Classes="primary" Content="Сохранить" Command="{Binding OkCommand}" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
