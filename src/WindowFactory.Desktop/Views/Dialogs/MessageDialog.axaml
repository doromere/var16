<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WindowFactory.Desktop.Views.Dialogs.MessageDialog"
        Title="{Binding Title}" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/logo.png">
  <StackPanel Margin="20" Spacing="18">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Нет" Command="{Binding CancelCommand}" IsVisible="{Binding ShowCancel}"/>
      <Button Classes="primary" Content="{Binding OkText}" Command="{Binding OkCommand}" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
