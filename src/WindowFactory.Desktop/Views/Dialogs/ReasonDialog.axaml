<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WindowFactory.Desktop.Views.Dialogs.ReasonDialog"
        Title="{Binding Title}" Width="500" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" Icon="/Assets/logo.png">
  <StackPanel Margin="20" Spacing="10">
    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap"/>
    <TextBox Text="{Binding Reason}" AcceptsReturn="True" TextWrapping="Wrap" Height="110" Watermark="Причина"/>
    <TextBlock Text="{Binding Counter}" Foreground="#64748B"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Отмена" Command="{Binding CancelCommand}"/>
      <Button Classes="danger" Content="Подтвердить" Command="{Binding OkCommand}"/>
    </StackPanel>
  </StackPanel>
</Window>
